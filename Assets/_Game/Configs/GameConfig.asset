    size: {x: 1.3, y: 1.5}
    height: 0.4
    ability: 2
    abilityTitle: "\u0421\u0442\u0435\u043D\u043A\u0430"
    abilityDescription: "\u0421\u0442\u0430\u0432\u0438\u0442 \u0441\u0432\u0435\u0442\u044F\u0449\u0443\u044E\u0441\u044F \u0441\u0442\u0435\u043D\u0443 \u043D\u0430 6 \u0441: \u0443\u043A\u0440\u044B\u0442\u0438\u0435 \u0438 \u043D\u043E\u0432\u044B\u0439 \u0431\u043E\u0440\u0442 \u0434\u043B\u044F \u0440\u0438\u043A\u043E\u0448\u0435\u0442\u0430."
