    speed: 6.6
    turnSpeed: 540
    size: {x: 0.95, y: 1.15}
    height: 0.26
    ability: 0
    abilityTitle: "\u0420\u044B\u0432\u043E\u043A"
    abilityDescription: "\u0420\u0435\u0437\u043A\u0438\u0439 \u0440\u044B\u0432\u043E\u043A. \u041F\u043E\u043A\u0430 \u043B\u0435\u0442\u0438\u0448\u044C, \u043F\u0443\u043B\u0438 \u043F\u0440\u043E\u0445\u043E\u0434\u044F\u0442 \u043D\u0430\u0441\u043A\u0432\u043E\u0437\u044C."
    abilityCooldown: 2.5
    abilityDuration: 0.25
  - id: barsuk
    title: "\u0411\u0430\u0440\u0441\u0443\u043A"
    description: "\u0421\u0440\u0435\u0434\u043D\u0438\u0439. \u0411\u0430\u043B\u0430\u043D\u0441 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0438 \u0438 \u0431\u0440\u043E\u043D\u0438."
    maxHp: 5
    speed: 5
    turnSpeed: 540
    size: {x: 1.1, y: 1.3}
    height: 0.32
    ability: 1
    abilityTitle: "\u0417\u0435\u0440\u043A\u0430\u043B\u043E"
    abilityDescription: "2,5 \u0441 \u0431\u0440\u043E\u043D\u044F \u043E\u0442\u0440\u0430\u0436\u0430\u0435\u0442 \u043F\u0443\u043B\u0438. \u041E\u0442\u0440\u0430\u0436\u0451\u043D\u043D\u0430\u044F \u043F\u0443\u043B\u044F \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F \u0442\u0432\u043E\u0435\u0439."
    abilityCooldown: 7
    abilityDuration: 2.5
  - id: begemot
    title: "\u0411\u0435\u0433\u0435\u043C\u043E\u0442"
    description: "\u0422\u044F\u0436\u0451\u043B\u044B\u0439 \u0438 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u044B\u0439. \u0414\u0435\u0440\u0436\u0438\u0442 \u043C\u043D\u043E\u0433\u043E \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u0439."
