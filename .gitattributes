# Текстовые файлы с нормализацией переводов строк
* text=auto
*.cs text diff=csharp
*.txt text
*.md text

# Сцены и префабы Unity сливаются через UnityYAMLMerge (см. README)
*.unity  text merge=unityyamlmerge eol=lf
*.prefab text merge=unityyamlmerge eol=lf
*.asset  text merge=unityyamlmerge eol=lf
*.mat    text merge=unityyamlmerge eol=lf
*.meta   text eol=lf

# Бинарные. Git LFS не используем: ZIP с GitHub не содержит LFS-файлов
*.png binary
*.jpg binary
*.psd binary
*.aseprite binary
*.ase binary
*.wav binary
*.ogg binary
*.mp3 binary
*.fbx binary
*.ttf binary
*.otf binary
